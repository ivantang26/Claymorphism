---
import ClayButton from "./ClayButton.astro";
import Icon from "./Icon.astro";
import { NAV } from "~/data/site";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);
---

<header class="nav-shell">
  <nav class="nav clay clay--surface wrap-inner" aria-label="Main">
    <a href="/" class="brand" aria-label="Doodle Math home">
      <img src="/art/mark-64.webp" alt="" width="40" height="40" />
      <span>Doodle Math</span>
    </a>

    <ul class="links" role="list">
      {
        NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l.href)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <ClayButton href="/schools" colour="lilac" size="sm" aria-current={current("/schools")}>For schools</ClayButton>
      <ClayButton href="/signup" colour="peach" size="sm">Start free trial</ClayButton>
    </div>

    <button class="menu-btn clay-chip" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <Icon name="list" />
      <span>Menu</span>
    </button>
  </nav>

  <div id="mobile-menu" class="sheet clay clay--surface" hidden data-menu>
    <ul role="list">
      {
        NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l.href)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="sheet-actions">
      <ClayButton href="/schools" colour="lilac" block>For schools</ClayButton>
      <ClayButton href="/signup" colour="peach" block>Start free trial</ClayButton>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (toggle && menu) {
    const label = toggle.querySelector("span")!;
    const set = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      label.textContent = open ? "Close" : "Menu";
    };
    toggle.addEventListener("click", () => set(menu.hidden));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) {
        set(false);
        toggle.focus();
      }
    });
    matchMedia("(min-width: 1200px)").addEventListener("change", (e) => e.matches && set(false));
  }
</script>

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 50; /* layer: sticky nav */
    padding: 10px var(--gutter) 0;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: var(--max);
    height: 64px;
    margin-inline: auto;
    padding: 0 10px 0 16px;
    border-radius: var(--r-pill);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    white-space: nowrap;
    border-radius: var(--r-pill);
  }
  .links {
    display: none;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    gap: 4px;
  }
  .links a,
  .sheet a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover {
    background: rgb(var(--page-shadow-rgb) / 0.07);
  }
  .links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
  }
  .actions {
    display: none;
    gap: 10px;
  }
  .menu-btn {
    margin-left: auto;
    cursor: pointer;
  }
  .sheet {
    max-width: var(--max);
    margin: 10px auto 0;
    padding: 12px;
  }
  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sheet a {
    font-size: 1.15rem;
    padding: 14px 16px;
  }
  .sheet a[aria-current="page"] {
    background: rgb(var(--page-shadow-rgb) / 0.08);
  }
  .sheet-actions {
    display: grid;
    gap: 12px;
    padding: 12px 4px 4px;
  }

  /* phone: brand + menu; tablet: brand + both buttons + menu; desktop: everything on one line */
  @media (min-width: 768px) {
    .actions {
      display: flex;
      margin-left: auto;
    }
    .menu-btn {
      margin-left: 0;
    }
    .sheet-actions {
      display: none;
    }
  }
  @media (min-width: 1200px) {
    .links {
      display: flex;
    }
    .actions {
      margin-left: 0;
    }
    .menu-btn {
      display: none;
    }
  }
</style>

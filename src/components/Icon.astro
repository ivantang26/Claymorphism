---
import { icon, type IconName } from "~/lib/icons";
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<span class:list={["icon", cls]} set:html={icon(name)} />

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    width: 1.2em;
    height: 1.2em;
    flex: none;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>

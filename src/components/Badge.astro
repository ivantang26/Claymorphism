---
import Icon from "./Icon.astro";
import type { IconName } from "~/lib/icons";
interface Props {
  icon: IconName;
  colour?: "peach" | "mint" | "lilac" | "sky" | "lemon" | "pink";
  size?: number;
  label?: string;
}
const { icon, colour = "lemon", size = 64, label } = Astro.props;
---

<span class="clay-badge" style={`--size:${size}px;--clay:var(--clay-${colour})`} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <Icon name={icon} />
</span>
